{
  "redirects": [
    {
      "source": "/horaires",
      "destination": "/horaires/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://miniso-horaires-cah5.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://miniso-horaires-cah5.firebaseapp.com/__/firebase/:path*"
    }
  ]
}