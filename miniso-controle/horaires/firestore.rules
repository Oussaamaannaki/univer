rules_version = '2';

// MINISO · Horaires — règles de sécurité Firestore
// À coller dans Firebase > Firestore Database > Règles, puis « Publier ».
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Qui est qui ----
    function signedIn() { return request.auth != null; }
    // Compte propriétaire (directeur du magasin) : courriel confirmé obligatoire
    function isOwner() {
      return signedIn()
        && request.auth.token.email.lower() == 'annakioussama99@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(userPath()); }
    function profile() { return get(userPath()).data; }
    function isActive() { return isOwner() || (hasProfile() && profile().status == 'active'); }
    function isManager() {
      return isOwner() || (hasProfile() && profile().status == 'active' && profile().role == 'manager');
    }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function onlyChanged(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function validName(v) { return v is string && v.size() > 0 && v.size() <= 60; }

    // ---- Profils (nom, poste, rôle, statut) ----
    match /users/{uid} {
      allow read: if isActive() || isSelf(uid);
      // Inscription : un nouveau compte est toujours « en attente » (sauf le propriétaire)
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'status', 'role', 'position', 'color', 'createdAt', 'updatedAt'])
        && validName(request.resource.data.firstName) && validName(request.resource.data.lastName)
        && ((request.resource.data.status == 'pending' && request.resource.data.role == 'employee') || isOwner());
      // L'employé modifie seulement son nom ; la direction approuve, attribue le poste, etc.
      // Seul le propriétaire peut changer un rôle (employé / gérant).
      allow update: if (isSelf(uid) && onlyChanged(['firstName', 'lastName', 'updatedAt'])
                        && validName(request.resource.data.firstName) && validName(request.resource.data.lastName))
                    || (isManager() && (isOwner() || request.resource.data.role == resource.data.role));
      allow delete: if isOwner();
    }

    // ---- Coordonnées (courriel, téléphone) : l'employé et la direction seulement ----
    match /contacts/{uid} {
      allow read: if isManager() || isSelf(uid);
      allow create, update: if isManager() || (isSelf(uid)
        && request.resource.data.keys().hasOnly(['email', 'phone', 'emailVerified', 'updatedAt'])
        && request.resource.data.email == request.auth.token.email
        && (!('emailVerified' in request.resource.data)
            || request.resource.data.emailVerified == false
            || request.auth.token.email_verified == true));
      allow delete: if isOwner();
    }

    // ---- Taux horaires : la direction (et l'employé pour le sien) ----
    match /wages/{uid} {
      allow read: if isManager() || isSelf(uid);
      allow write: if isManager();
    }

    // ---- Disponibilités ----
    match /availability/{uid} {
      allow read: if isManager() || isSelf(uid);
      allow write: if isManager() || isSelf(uid);
    }

    // ---- Congés ----
    match /timeoff/{id} {
      allow read: if isManager() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isActive()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isManager()
        || (signedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled' && onlyChanged(['status', 'updatedAt']));
      allow delete: if isManager();
    }

    // ---- Quarts : les employés ne voient que l'horaire publié ----
    match /shifts/{id} {
      allow read: if isManager() || (isActive() && resource.data.published == true);
      allow write: if isManager();
    }
    match /weeks/{weekId} {
      allow read: if isActive();
      allow write: if isManager();
    }
    match /budgets/{weekId} {
      allow read, write: if isManager();
    }

    // ---- Échanges de quarts ----
    match /swaps/{id} {
      allow read: if isActive();
      // On ne peut offrir que son propre quart
      allow create: if isActive()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == 'open'
        && get(/databases/$(database)/documents/shifts/$(request.resource.data.shiftId)).data.uid == request.auth.uid;
      allow update: if isManager()
        // L'auteur annule son offre
        || (isActive() && resource.data.fromUid == request.auth.uid
            && resource.data.status in ['open', 'taken'] && request.resource.data.status == 'cancelled'
            && onlyChanged(['status', 'updatedAt']))
        // Un collègue prend le quart (la direction approuve ensuite)
        || (isActive() && resource.data.status == 'open' && resource.data.fromUid != request.auth.uid
            && (resource.data.toUid == '' || resource.data.toUid == request.auth.uid)
            && request.resource.data.status == 'taken' && request.resource.data.takenBy == request.auth.uid
            && onlyChanged(['status', 'takenBy', 'takenAt', 'updatedAt']));
      allow delete: if isManager();
    }

    // ---- Nouvelles (notifications dans l'application) ----
    match /feed/{id} {
      allow read: if isManager()
        || (isActive() && (resource.data.audience == 'all' || resource.data.audience == request.auth.uid));
      allow create, delete: if isManager();
    }

    // ---- Réglages du magasin (postes, quarts types) ----
    match /settings/{docId} {
      allow read: if isActive();
      allow write: if isManager();
    }
  }
}
